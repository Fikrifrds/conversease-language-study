# ═══════════════════════════════════════════════════════════════
# Conversease Production Environment — Manual Transfer Beta
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.production and fill in the values.
# Lines starting with # are comments — remove # to enable.

# ── Core ──────────────────────────────────────────────────────
APP_ENV=production
RELEASE_VERSION=0.1.0
LOG_LEVEL=info

# ── URLs ──────────────────────────────────────────────────────
PUBLIC_APP_URL=https://conversease.com
API_BASE_URL=https://api.conversease.com
NEXT_PUBLIC_API_BASE_URL=https://api.conversease.com/api
CORS_ORIGINS_RAW=["https://conversease.com"]

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/conversease_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.conversease.com/api/auth/google/callback

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@conversease.com
EMAIL_REPLY_TO=support@conversease.com
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# ── Payment — Manual Transfer ────────────────────────────────
PAYMENT_ADMIN_API_KEY=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING
PAYMENT_ADMIN_EMAIL=denahku.team@gmail.com
MANUAL_TRANSFER_BANK_NAME=Bank Jago
MANUAL_TRANSFER_ACCOUNT_NUMBER=XXXXXXXXXX
MANUAL_TRANSFER_ACCOUNT_HOLDER=PT Conversease
MANUAL_TRANSFER_EXPIRE_HOURS=12
MANUAL_TRANSFER_UNIQUE_CODE_MIN=101
MANUAL_TRANSFER_UNIQUE_CODE_MAX=999

# ── LLM (Together AI) ───────────────────────────────────────
TOGETHER_API_KEY=
TOGETHER_API_BASE_URL=https://api.together.xyz/v1
TOGETHER_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_TIMEOUT_SECONDS=30
LLM_DEFAULT_PROVIDER=together

# ── TTS (MiniMax — English audio) ───────────────────────────
MINIMAX_API_KEY=
MINIMAX_API_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_VOICE_ID=professional_reporter_female
MINIMAX_TTS_TIMEOUT_SECONDS=60

# ── S3 Storage ───────────────────────────────────────────────
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=30
ADMIN_RATE_LIMIT_REQUESTS=120

# ── Admin ────────────────────────────────────────────────────
ADMIN_EMAILS_RAW=["denahku.team@gmail.com"]

# ── API Workers ──────────────────────────────────────────────
API_WORKERS=2

# ── Postgres (for Docker Compose) ───────────────────────────
POSTGRES_USER=conversease
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=conversease_db

# ── Optional (can skip for beta) ─────────────────────────────
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# ASSEMBLYAI_API_KEY=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
